{"text": "<meta name=\"dash-one-writer\">\n<style>\n.apx{display:grid;gap:var(--cds-gap-xl);font-family:var(--font-anthropic-sans);color:var(--color-fg);font-size:var(--cds-font-size-body);min-width:0}\n.apx-title{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);margin:0;text-wrap:balance}\n.apx-lead{margin:var(--cds-gap-sm) 0 0;max-width:72ch;line-height:1.5}\n.apx-sec{display:grid;gap:var(--cds-gap-md);min-width:0}\n.apx-h2{font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium);margin:0;text-wrap:balance}\n.apx-h3{font-size:var(--cds-font-size-body);font-weight:var(--cds-font-weight-medium);margin:var(--cds-gap-sm) 0 0}\n.apx-note{color:var(--color-fg-muted);font-size:var(--cds-font-size-caption);margin:0;max-width:78ch;line-height:1.5}\n.apx-cards{display:grid;gap:var(--cds-gap-md);grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}\n.apx-card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:grid;gap:var(--cds-gap-sm);align-content:start;min-width:0}\n.apx-label{color:var(--color-fg-muted);font-size:var(--cds-font-size-caption);line-height:1.4}\n.apx-big{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);font-variant-numeric:tabular-nums;line-height:1.1}\n.apx-kv{display:flex;justify-content:space-between;gap:var(--cds-gap-md);font-size:var(--cds-font-size-caption);font-variant-numeric:tabular-nums}\n.apx-kv > :first-child{color:var(--color-fg-muted)}\n.apx-good{color:var(--color-ok)}\n.apx-bad{color:var(--color-bad)}\n.apx-warn{color:var(--color-warn)}\n.apx-muted{color:var(--color-fg-muted)}\n.apx-bar{height:8px;border-radius:4px;background:var(--color-border-line);overflow:hidden}\n.apx-bar-fill{display:block;height:100%;width:0;background:var(--color-fg-muted)}\n.apx-scroll{overflow-x:auto;min-width:0}\n.apx-tall{max-height:340px;overflow-y:auto}\n.apx-table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums;font-size:var(--cds-font-size-caption)}\n.apx-table .apx-th{text-align:left;color:var(--color-fg-muted);font-weight:var(--cds-font-weight-medium);border-bottom:1px solid var(--color-border-line);padding:var(--cds-pad-xs) var(--cds-pad-sm);white-space:nowrap;position:sticky;top:0;background:var(--color-bg)}\n.apx-table .apx-td{border-bottom:1px solid var(--color-border-line);padding:var(--cds-pad-xs) var(--cds-pad-sm);vertical-align:top;line-height:1.4}\n.apx-table .apx-num{text-align:right;white-space:nowrap}\n.apx-wide{min-width:15em}\n.apx-table .apx-nowrap{white-space:nowrap}\n.apx-table .apx-name{min-width:13em}\n.apx-table .apx-why{min-width:22em}\n.apx-pill{display:inline-block;border:1px solid currentColor;border-radius:999px;padding:0 var(--cds-pad-sm);white-space:nowrap}\n.apx-row{display:flex;flex-wrap:wrap;align-items:center;gap:var(--cds-gap-md)}\n.apx-chart{position:relative;min-height:320px;min-width:0}\n.apx-tip{position:absolute;pointer-events:none;background:var(--cds-surface-popover);border:1px solid var(--cds-border);box-shadow:var(--cds-shadow-popover);border-radius:var(--cds-radius);padding:var(--cds-pad-sm);font-size:var(--cds-font-size-caption);font-variant-numeric:tabular-nums;white-space:nowrap;line-height:1.5}\n.apx-legend{display:flex;flex-wrap:wrap;gap:var(--cds-gap-md);font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.apx-swatch{display:inline-block;width:16px;height:3px;vertical-align:middle;margin-right:6px;background:var(--color-fg-muted)}\n.apx-axis text{fill:var(--cds-text-secondary);font-size:var(--cds-font-size-caption);font-family:var(--font-anthropic-sans)}\n.apx-axis path,.apx-axis line{stroke:var(--cds-chart-axis)}\n.apx-grid line{stroke:var(--cds-chart-grid)}\n.apx-defs{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);max-width:78ch;line-height:1.5}\n.apx [data-dash-source-state=refreshing]{opacity:.5}\n</style>\n\n<div class=\"apx\">\n  <header id=\"apx-top\">\n    <h1 class=\"apx-title\">APEX Risk and Monitoring</h1>\n    <p class=\"apx-lead\">Proven strategies: <b data-draw=\"val\" data-source=\"status_counts\" data-row=\"0\" data-field=\"proven\" data-fmt=\"int\">\u2014</b> of <b data-draw=\"val\" data-source=\"status_counts\" data-row=\"0\" data-field=\"total\" data-fmt=\"int\">\u2014</b> tested. Ahead of their benchmark for the risk taken but not yet proven: <b data-draw=\"val\" data-source=\"status_counts\" data-row=\"0\" data-field=\"provisional\" data-fmt=\"int\">\u2014</b>. Failed or no better than holding: <b data-draw=\"val\" data-source=\"status_counts\" data-row=\"0\" data-field=\"not_passing\" data-fmt=\"int\">\u2014</b>. The forward paper test has <b data-draw=\"val\" data-source=\"forward_totals\" data-row=\"0\" data-field=\"closed_trades\" data-fmt=\"int\">\u2014</b> closed trades so far, and each account is reviewed at <b data-draw=\"gate\">\u2014</b>. No real money is traded anywhere on this page.</p>\n  </header>\n\n  <section class=\"apx-sec\" id=\"apx-forward\">\n    <h2 class=\"apx-h2\">ETF forward paper test</h2>\n    <p class=\"apx-note\">Paper only. This is the forward test MEDS already runs on the weak-close ETF rules, the best-supported family to come out of testing. It started <span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"go_live\" data-fmt=\"date\">\u2014</span> and was last updated <span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"as_of\" data-fmt=\"date\">\u2014</span>, after <span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"sessions\" data-fmt=\"int\">\u2014</span> trading sessions. A handful of trades says nothing yet in either direction.</p>\n    <div class=\"apx-cards\">\n      <div class=\"apx-card\" id=\"apx-account-a\">\n        <div class=\"apx-label\">Account A: buy a weak close above the 200-day average, hold 5 sessions</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"equity_change\" data-fmt=\"pct\" data-tone=\"sign\">\u2014</span></div>\n        <div class=\"apx-label\">Equity change since the start</div>\n        <div class=\"apx-kv\"><span>Holding SPY, same period</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"hold_spy_change\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Closed trades</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"closed_trades\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Of which winners</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"wins\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Open positions</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=A\" data-field=\"open_positions\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Closed trades needed before judging</span><span data-draw=\"gate\">\u2014</span></div>\n        <div class=\"apx-bar\" role=\"img\" aria-label=\"Progress of account A toward its review\"><span class=\"apx-bar-fill\" data-draw=\"progress\" data-account=\"A\" data-source=\"forward_accounts\"></span></div>\n      </div>\n      <div class=\"apx-card\" id=\"apx-account-b\">\n        <div class=\"apx-label\">Account B: buy a weak close, sell on strength, 5 sessions at most</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=B\" data-field=\"equity_change\" data-fmt=\"pct\" data-tone=\"sign\">\u2014</span></div>\n        <div class=\"apx-label\">Equity change since the start</div>\n        <div class=\"apx-kv\"><span>Holding SPY, same period</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=B\" data-field=\"hold_spy_change\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=B\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Closed trades</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=B\" data-field=\"closed_trades\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Of which winners</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=B\" data-field=\"wins\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Open positions</span><span data-draw=\"val\" data-source=\"forward_accounts\" data-where=\"account=B\" data-field=\"open_positions\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Closed trades needed before judging</span><span data-draw=\"gate\">\u2014</span></div>\n        <div class=\"apx-bar\" role=\"img\" aria-label=\"Progress of account B toward its review\"><span class=\"apx-bar-fill\" data-draw=\"progress\" data-account=\"B\" data-source=\"forward_accounts\"></span></div>\n      </div>\n    </div>\n\n    <h3 class=\"apx-h3\" id=\"apx-open-positions\">Open positions</h3>\n    <div class=\"apx-scroll\">\n      <table class=\"apx-table\" data-source=\"forward_positions\" data-row-key=\"key\">\n        <thead><tr>\n          <th class=\"apx-th\" data-field=\"account\">Account</th>\n          <th class=\"apx-th\" data-field=\"symbol\">Symbol</th>\n          <th class=\"apx-th\" data-field=\"entry_date\">Entered</th>\n          <th class=\"apx-th apx-num\" data-field=\"entry_price\">Entry price</th>\n          <th class=\"apx-th apx-num\" data-field=\"last_price\">Last price</th>\n          <th class=\"apx-th apx-num\" data-field=\"pnl\">Gain or loss</th>\n          <th class=\"apx-th apx-num\" data-field=\"sessions_held\">Sessions held</th>\n        </tr></thead>\n        <tbody data-draw=\"rows-positions\"></tbody>\n      </table>\n    </div>\n\n    <h3 class=\"apx-h3\" id=\"apx-closed-trades\">Closed trades</h3>\n    <div class=\"apx-scroll\">\n      <table class=\"apx-table\" data-source=\"forward_trades\" data-row-key=\"key\">\n        <thead><tr>\n          <th class=\"apx-th\" data-field=\"account\">Account</th>\n          <th class=\"apx-th\" data-field=\"symbol\">Symbol</th>\n          <th class=\"apx-th\" data-field=\"entry_date\">Entered</th>\n          <th class=\"apx-th\" data-field=\"exit_date\">Exited</th>\n          <th class=\"apx-th apx-num\" data-field=\"sessions\">Sessions</th>\n          <th class=\"apx-th\" data-field=\"exit_reason\">Exit</th>\n          <th class=\"apx-th apx-num\" data-field=\"return\">Return</th>\n        </tr></thead>\n        <tbody data-draw=\"rows-forward-trades\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"apx-sec\" id=\"apx-alerts\">\n    <h2 class=\"apx-h2\">Risk alerts</h2>\n    <p class=\"apx-note\">Newest first. A watch is an open paper position down <span data-draw=\"limit\" data-name=\"watch\">\u2014</span>% or more. Warnings and stops come from the risk limits in the QQQ replay below: a <span data-draw=\"limit\" data-name=\"daily\">\u2014</span>% loss in a day pauses new buying until the next day, and a <span data-draw=\"limit\" data-name=\"drawdown\">\u2014</span>% fall from the high stops trading until a person clears it.</p>\n    <div class=\"apx-scroll apx-tall\">\n      <table class=\"apx-table\" data-source=\"alerts\" data-row-key=\"n\">\n        <thead><tr>\n          <th class=\"apx-th\" data-field=\"time\">When (UTC)</th>\n          <th class=\"apx-th\" data-field=\"severity\">Level</th>\n          <th class=\"apx-th\" data-field=\"account\">Account</th>\n          <th class=\"apx-th apx-wide\" data-field=\"alert\">Alert</th>\n          <th class=\"apx-th apx-num\" data-field=\"equity\">Equity then</th>\n        </tr></thead>\n        <tbody data-draw=\"rows-alerts\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"apx-sec\" id=\"apx-replay\">\n    <h2 class=\"apx-h2\">Weak-close rule through the paper engine, 2016 to 2026</h2>\n    <p class=\"apx-note\">A rehearsal, not a forward test: real QQQ prices from 2016 on, replayed session by session through the paper trading engine, with no commission and a cost of <span data-draw=\"limit\" data-name=\"cost\">\u2014</span> basis point a side for the spread. The rule is the one pattern that held in every test: at 15:55, buy QQQ if it is in the bottom <span data-draw=\"limit\" data-name=\"bottom\">\u2014</span>% of its range for the day; sell at the first 15:55 that shows a profit, or after <span data-draw=\"limit\" data-name=\"hold\">\u2014</span> sessions. It made money but less than holding QQQ over these years. Every line starts with <span data-draw=\"val\" data-source=\"replay_equity\" data-row=\"0\" data-field=\"engine\" data-fmt=\"usd\">\u2014</span>.</p>\n    <div class=\"apx-cards\">\n      <div class=\"apx-card\" id=\"apx-run-engine\">\n        <div class=\"apx-label\">Paper engine, no limits</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Completed trades</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine\" data-field=\"round_trips\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Orders</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine\" data-field=\"orders\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Winning trades</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine\" data-field=\"win_rate\" data-fmt=\"pctu\">\u2014</span></div>\n      </div>\n      <div class=\"apx-card\" id=\"apx-run-limits\">\n        <div class=\"apx-label\">Paper engine with the <span data-draw=\"limit\" data-name=\"daily\">\u2014</span>% daily and <span data-draw=\"limit\" data-name=\"drawdown\">\u2014</span>% drawdown limits</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine_with_limits\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine_with_limits\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine_with_limits\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>State at the end</span><span class=\"apx-bad\" data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine_with_limits\" data-field=\"state\" data-fmt=\"text\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Orders</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine_with_limits\" data-field=\"orders\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Buy decisions blocked</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=engine_with_limits\" data-field=\"blocked_decisions\" data-fmt=\"int\">\u2014</span></div>\n      </div>\n      <div class=\"apx-card\" id=\"apx-run-backtest\">\n        <div class=\"apx-label\">Backtest of the same rules, a separate program</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=backtest\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=backtest\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Completed trades</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=backtest\" data-field=\"round_trips\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Engine minus backtest, points</span><span data-draw=\"val\" data-source=\"replay_gap\" data-row=\"0\" data-field=\"gap_points\" data-fmt=\"num1\">\u2014</span></div>\n      </div>\n      <div class=\"apx-card\" id=\"apx-run-hold\">\n        <div class=\"apx-label\">Hold QQQ, for comparison</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=hold\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=hold\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=hold\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n      </div>\n    </div>\n\n    <h3 class=\"apx-h3\" id=\"apx-equity-heading\">Account equity</h3>\n    <div class=\"apx-legend\">\n      <span><span class=\"apx-swatch\" data-series=\"engine\"></span>Paper engine, no limits</span>\n      <span><span class=\"apx-swatch\" data-series=\"engine_with_limits\"></span>Paper engine with limits</span>\n      <span><span class=\"apx-swatch\" data-series=\"hold_qqq\"></span>Hold QQQ</span>\n    </div>\n    <div class=\"apx-chart\" id=\"apx-equity\" data-draw=\"equity-chart\" data-source=\"replay_equity\">\u2014</div>\n\n    <h3 class=\"apx-h3\" id=\"apx-replay-trades\">Trade history, paper engine with no limits</h3>\n    <div class=\"apx-scroll apx-tall\">\n      <table class=\"apx-table\" data-source=\"replay_trades\" data-row-key=\"n\">\n        <thead><tr>\n          <th class=\"apx-th apx-num\" data-field=\"n\">#</th>\n          <th class=\"apx-th\" data-field=\"entry_date\">Bought</th>\n          <th class=\"apx-th\" data-field=\"exit_date\">Sold</th>\n          <th class=\"apx-th apx-num\" data-field=\"entry_price\">Buy price</th>\n          <th class=\"apx-th apx-num\" data-field=\"exit_price\">Sell price</th>\n          <th class=\"apx-th apx-num\" data-field=\"days_held\">Sessions held</th>\n          <th class=\"apx-th apx-num\" data-field=\"return\">Return after costs</th>\n        </tr></thead>\n        <tbody data-draw=\"rows-replay-trades\"></tbody>\n      </table>\n    </div>\n\n    <h3 class=\"apx-h3\" id=\"apx-tqqq\">The same rule through TQQQ, the 3x fund</h3>\n    <p class=\"apx-note\">Same signal from QQQ, same dates, but the money goes into TQQQ, which moves about three times as far each day. The gain is larger and so is every fall.</p>\n    <div class=\"apx-cards\">\n      <div class=\"apx-card\" id=\"apx-tqqq-engine\">\n        <div class=\"apx-label\">Paper engine, no limits</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_engine\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_engine\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_engine\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Completed trades</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_engine\" data-field=\"round_trips\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Winning trades</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_engine\" data-field=\"win_rate\" data-fmt=\"pctu\">\u2014</span></div>\n      </div>\n      <div class=\"apx-card\" id=\"apx-tqqq-limits\">\n        <div class=\"apx-label\">Paper engine with the <span data-draw=\"limit\" data-name=\"daily\">\u2014</span>% daily and <span data-draw=\"limit\" data-name=\"drawdown\">\u2014</span>% drawdown limits</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_limits\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_limits\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>State at the end</span><span class=\"apx-bad\" data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_limits\" data-field=\"state\" data-fmt=\"text\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Completed trades</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_limits\" data-field=\"round_trips\" data-fmt=\"int\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Buy decisions blocked</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_limits\" data-field=\"blocked_decisions\" data-fmt=\"int\">\u2014</span></div>\n      </div>\n      <div class=\"apx-card\" id=\"apx-tqqq-hold\">\n        <div class=\"apx-label\">Hold TQQQ, for comparison</div>\n        <div class=\"apx-big\"><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_hold\" data-field=\"final_equity\" data-fmt=\"usd\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Return</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_hold\" data-field=\"total_return\" data-fmt=\"pct\">\u2014</span></div>\n        <div class=\"apx-kv\"><span>Largest drop from a high</span><span data-draw=\"val\" data-source=\"replay_summary\" data-where=\"run=tqqq_hold\" data-field=\"max_drawdown\" data-fmt=\"pctu\">\u2014</span></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"apx-sec\" id=\"apx-status\">\n    <h2 class=\"apx-h2\">Strategy status</h2>\n    <p class=\"apx-note\">Every strategy family tested, best first. A verdict is set by rule: a strategy must make money after costs on data it was never tuned on, and beat simply holding its market for the risk taken. Round-two rows were tested on 2023 to 2026 against the better of holding SPY and holding QQQ. Older-sample rows re-run the two leading rules on years before 2016 that no other test touched. Rows from MEDS are re-scored from its stored backtests, not re-run.</p>\n    <div class=\"apx-row\">\n      <label class=\"apx-label\" for=\"apx-status-filter\">Show</label>\n      <select class=\"dash-select\" id=\"apx-status-filter\">\n        <option value=\"\">All strategies</option>\n        <option value=\"proven\">Proven</option>\n        <option value=\"provisional\">Provisional</option>\n        <option value=\"no_edge\">No edge</option>\n        <option value=\"fragile\">Fragile</option>\n        <option value=\"inconclusive\">Inconclusive</option>\n        <option value=\"failed\">Failed</option>\n      </select>\n    </div>\n    <div class=\"apx-scroll\">\n      <table class=\"apx-table\" data-source=\"strategy_status\" data-row-key=\"id\">\n        <thead><tr>\n          <th class=\"apx-th apx-num\" data-field=\"rank\">#</th>\n          <th class=\"apx-th apx-wide\" data-field=\"strategy\">Strategy</th>\n          <th class=\"apx-th\" data-field=\"market\">Market</th>\n          <th class=\"apx-th\" data-field=\"status_label\">Verdict</th>\n          <th class=\"apx-th\" data-field=\"reason\">Why</th>\n          <th class=\"apx-th apx-num\" data-field=\"oos_sharpe\">Sharpe</th>\n          <th class=\"apx-th apx-num\" data-field=\"benchmark_sharpe\">Sharpe of holding</th>\n          <th class=\"apx-th apx-num\" data-field=\"oos_return_per_year\">Return a year</th>\n          <th class=\"apx-th apx-num\" data-field=\"oos_max_drawdown\">Largest drop</th>\n          <th class=\"apx-th apx-num\" data-field=\"win_rate\">Winning trades</th>\n          <th class=\"apx-th apx-num\" data-field=\"trades\">Trades</th>\n          <th class=\"apx-th apx-num\" data-field=\"settings_tried\">Settings tried</th>\n          <th class=\"apx-th\" data-field=\"tested_on\">Tested on</th>\n          <th class=\"apx-th\" data-field=\"source\">Source</th>\n        </tr></thead>\n        <tbody data-draw=\"rows-status\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <details class=\"apx-defs\" id=\"apx-definitions\">\n    <summary>What the terms mean</summary>\n    <p>Sharpe: return divided by how much the value swings, per year, measured on data the strategy was not tuned on. Holding the S&amp;P 500 scored <span data-draw=\"val\" data-source=\"strategy_status\" data-where=\"id=M01\" data-field=\"benchmark_sharpe\" data-fmt=\"num2\">\u2014</span> from 2019 to 2026. Higher is better, and it is the fairest way to compare a strategy that is only sometimes invested with one that always is.</p>\n    <p>Largest drop: the biggest fall from a high to a later low. Proven: beat holding on unseen data and passed both statistical tests. Provisional: ahead of holding for the risk taken, not statistically proven. No edge: only a smaller drop than holding. Fragile: works at one setting and not its neighbours. Inconclusive: too few trades to say. Failed: lost money after costs or was no better than holding.</p>\n    <p>Settings tried: how many versions of the idea were tested. The more that were tried, the better the best one looks by luck alone.</p>\n  </details>\n</div>\n\n<script>\nconst REVIEW_TRADES = 100;   // closed trades per account before the forward test is judged (set in the MEDS forward test)\n\ndash.calc('status_counts', {\n  inputs: ['strategy_status'],\n  title: 'Strategies by verdict',\n  description: 'How many strategy families fall under each verdict.',\n  fn: (strategies) => {\n    const n = (s) => strategies.filter((r) => r.status === s).length;\n    return [{proven: n('proven'), provisional: n('provisional'), not_passing: strategies.length - n('proven') - n('provisional'), total: strategies.length}];\n  },\n});\ndash.calc('forward_totals', {\n  inputs: ['forward_accounts'],\n  title: 'Forward paper test, both accounts',\n  description: 'Closed trades and winners summed over the two paper accounts.',\n  fn: (accounts) => [{closed_trades: d3.sum(accounts, (a) => +a.closed_trades), wins: d3.sum(accounts, (a) => +a.wins)}],\n});\ndash.calc('replay_gap', {\n  inputs: ['replay_summary'],\n  title: 'Paper engine versus backtest',\n  description: 'Total return of the paper engine minus the backtest of the same rules, in percentage points.',\n  fn: (runs) => {\n    const get = (id) => runs.find((r) => r.run === id);\n    const e = get('engine'), b = get('backtest');\n    return e && b ? [{gap_points: Math.round((+e.total_return - +b.total_return) * 10) / 10}] : [];\n  },\n});\n\nconst parseDay = d3.utcParse('%Y-%m-%d');\nconst fmtDay = d3.utcFormat('%b %-d, %Y');\nconst F = {\n  int: (v) => d3.format(',')(+v),\n  pct: (v) => d3.format('+.1f')(+v) + '%',\n  pctu: (v) => d3.format('.1f')(+v) + '%',\n  usd: (v) => d3.format('$,.2f')(+v),\n  num1: (v) => d3.format('+.1f')(+v),\n  num2: (v) => d3.format('.2f')(+v),\n  date: (v) => { const d = parseDay(v); return d ? fmtDay(d) : v; },\n  text: (v) => v,\n};\nconst blank = (v) => v === undefined || v === null || v === '';\n\nfunction rowsOf(id) {\n  const g = dash.data(id);\n  return {status: g.status, rows: g.status === 'ok' && Array.isArray(g.data) ? g.data : []};\n}\n\ndash.draw('val', (el) => {\n  const {rows} = rowsOf(el.dataset.source);\n  let row;\n  if (el.dataset.where) {\n    const i = el.dataset.where.indexOf('=');\n    const k = el.dataset.where.slice(0, i), v = el.dataset.where.slice(i + 1);\n    row = rows.find((r) => String(r[k]) === v);\n  } else {\n    row = rows[+(el.dataset.row || 0)];\n  }\n  const v = row ? row[el.dataset.field] : undefined;\n  if (blank(v)) { el.textContent = '\u2014'; return; }\n  el.textContent = (F[el.dataset.fmt] || F.text)(v);\n  if (el.dataset.tone === 'sign') {\n    el.classList.toggle('apx-good', +v > 0);\n    el.classList.toggle('apx-bad', +v < 0);\n  }\n});\n\ndash.draw('gate', (el) => { el.textContent = d3.format(',')(REVIEW_TRADES); });\n\n// Fixed references: the brief's two risk limits, the alert threshold for an open position, and the replayed rule's own settings\n// (spread cost in basis points a side, the bottom share of the day's range that counts as a weak close, the longest hold in sessions).\nconst LIMITS = {daily: 2, drawdown: 12, watch: 5, cost: 1, bottom: 15, hold: 5};\ndash.draw('limit', (el) => { el.textContent = String(LIMITS[el.dataset.name] ?? '\u2014'); });\n\ndash.draw('progress', (el) => {\n  const {rows} = rowsOf('forward_accounts');\n  const r = rows.find((a) => a.account === el.dataset.account);\n  el.style.width = (r ? Math.min(100, 100 * +r.closed_trades / REVIEW_TRADES) : 0) + '%';\n});\n\nfunction tableDrawing(name, source, cols, keyField, filter) {\n  dash.draw(name, (tbody) => {\n    const {status, rows} = rowsOf(source);\n    tbody.replaceChildren();\n    const shown = filter ? rows.filter(filter) : rows;\n    if (status !== 'ok' || !shown.length) {\n      const tr = document.createElement('tr'), td = document.createElement('td');\n      td.className = 'apx-td apx-muted';\n      td.colSpan = cols.length;\n      td.textContent = status === 'error' ? 'Failed to load' : status === 'ok' ? 'Nothing to show' : '\u2014';\n      tr.append(td);\n      tbody.append(tr);\n      return;\n    }\n    for (const r of shown) {\n      const tr = document.createElement('tr');\n      tr.dataset.key = encodeURIComponent(r[keyField]);\n      for (const c of cols) {\n        const td = document.createElement('td');\n        td.className = 'apx-td' + (c.num ? ' apx-num' : '') + (c.cls ? ' ' + c.cls : '');\n        const v = r[c.field];\n        if (c.pill) {\n          const s = document.createElement('span');\n          s.className = 'apx-pill ' + (c.pill(v, r) || '');\n          s.textContent = blank(v) ? '\u2014' : v;\n          td.append(s);\n        } else {\n          td.textContent = blank(v) ? '\u2014' : (F[c.fmt] || F.text)(v);\n          if (c.tone && !blank(v)) td.classList.add(+v > 0 ? 'apx-good' : +v < 0 ? 'apx-bad' : 'apx-muted');\n        }\n        tr.append(td);\n      }\n      tbody.append(tr);\n    }\n  });\n}\n\ntableDrawing('rows-positions', 'forward_positions', [\n  {field: 'account'}, {field: 'symbol'}, {field: 'entry_date', fmt: 'date', cls: 'apx-nowrap'}, {field: 'entry_price', fmt: 'usd', num: true},\n  {field: 'last_price', fmt: 'usd', num: true}, {field: 'pnl', fmt: 'pct', num: true, tone: true}, {field: 'sessions_held', fmt: 'int', num: true}], 'key');\ntableDrawing('rows-forward-trades', 'forward_trades', [\n  {field: 'account'}, {field: 'symbol'}, {field: 'entry_date', fmt: 'date', cls: 'apx-nowrap'}, {field: 'exit_date', fmt: 'date', cls: 'apx-nowrap'},\n  {field: 'sessions', fmt: 'int', num: true}, {field: 'exit_reason', cls: 'apx-nowrap'}, {field: 'return', fmt: 'pct', num: true, tone: true}], 'key');\ntableDrawing('rows-alerts', 'alerts', [\n  {field: 'time', cls: 'apx-nowrap'}, {field: 'severity', pill: (v) => (v === 'stop' ? 'apx-bad' : v === 'warning' ? 'apx-warn' : 'apx-muted')},\n  {field: 'account', cls: 'apx-nowrap'}, {field: 'alert'}, {field: 'equity', fmt: 'usd', num: true}], 'n');\ntableDrawing('rows-replay-trades', 'replay_trades', [\n  {field: 'n', fmt: 'int', num: true}, {field: 'entry_date', fmt: 'date', cls: 'apx-nowrap'}, {field: 'exit_date', fmt: 'date', cls: 'apx-nowrap'}, {field: 'entry_price', fmt: 'usd', num: true},\n  {field: 'exit_price', fmt: 'usd', num: true}, {field: 'days_held', fmt: 'int', num: true},\n  {field: 'return', fmt: 'pct', num: true, tone: true}], 'n');\n\nconst statusFilter = document.getElementById('apx-status-filter');\ntableDrawing('rows-status', 'strategy_status', [\n  {field: 'rank', fmt: 'int', num: true}, {field: 'strategy', cls: 'apx-name'}, {field: 'market', cls: 'apx-nowrap'},\n  {field: 'status_label', pill: (v, r) => (r.status === 'proven' ? 'apx-good' : r.status === 'provisional' ? 'apx-warn' : r.status === 'failed' ? 'apx-bad' : 'apx-muted')},\n  {field: 'reason', cls: 'apx-why'},\n  {field: 'oos_sharpe', fmt: 'num2', num: true}, {field: 'benchmark_sharpe', fmt: 'num2', num: true}, {field: 'oos_return_per_year', fmt: 'pct', num: true},\n  {field: 'oos_max_drawdown', fmt: 'pctu', num: true}, {field: 'win_rate', fmt: 'pctu', num: true}, {field: 'trades', fmt: 'int', num: true},\n  {field: 'settings_tried', fmt: 'int', num: true}, {field: 'tested_on', cls: 'apx-nowrap'}, {field: 'source', cls: 'apx-nowrap'}], 'id',\n  (r) => !statusFilter || !statusFilter.value || r.status === statusFilter.value);\nif (statusFilter) statusFilter.addEventListener('change', () => dash.draw('rows-status'));\n\nconst SERIES = [\n  {key: 'hold_qqq', label: 'Hold QQQ', color: 'var(--cds-chart-muted)'},\n  {key: 'engine_with_limits', label: 'Paper engine with limits', color: dash.colors[1]},\n  {key: 'engine', label: 'Paper engine, no limits', color: dash.colors[0]},\n];\ndocument.querySelectorAll('.apx-swatch').forEach((s) => {\n  const m = SERIES.find((x) => x.key === s.dataset.series);\n  if (m) s.style.background = m.color;\n});\n\ndash.draw('equity-chart', (el) => {\n  const {status, rows} = rowsOf('replay_equity');\n  el.replaceChildren();\n  if (status !== 'ok' || !rows.length) { el.textContent = status === 'error' ? 'Failed to load' : '\u2014'; return; }\n  const data = rows.map((r) => ({date: parseDay(r.date), engine: +r.engine, engine_with_limits: +r.engine_with_limits, hold_qqq: +r.hold_qqq})).filter((d) => d.date);\n  const W = Math.max(280, el.clientWidth || 640), H = 320, mt = 10, mb = 26, mr = 12;\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img')\n    .attr('aria-label', 'Account equity over time for the paper engine without limits, the paper engine with risk limits, and holding QQQ');\n  const y = d3.scaleLinear().domain([0, d3.max(data, (d) => Math.max(d.engine, d.engine_with_limits || 0, d.hold_qqq)) * 1.05]).range([H - mb, mt]).nice();\n  const yAxis = svg.append('g').attr('class', 'apx-axis').call(d3.axisLeft(y).ticks(5).tickFormat(d3.format('$,.0f')).tickSizeOuter(0));\n  let ml = 0;\n  yAxis.selectAll('text').each(function () { ml = Math.max(ml, this.getComputedTextLength()); });\n  ml = Math.ceil(ml) + 14;\n  yAxis.attr('transform', `translate(${ml},0)`);\n  const x = d3.scaleUtc().domain(d3.extent(data, (d) => d.date)).range([ml, W - mr]);\n  svg.append('g').attr('class', 'apx-grid').selectAll('line').data(y.ticks(5)).join('line')\n    .attr('x1', ml).attr('x2', W - mr).attr('y1', (d) => y(d)).attr('y2', (d) => y(d));\n  svg.append('g').attr('class', 'apx-axis').attr('transform', `translate(0,${H - mb})`)\n    .call(d3.axisBottom(x).ticks(Math.max(2, Math.floor((W - ml) / 110))).tickFormat(d3.utcFormat('%b %Y')).tickSizeOuter(0));\n  for (const s of SERIES) {\n    svg.append('path').datum(data.filter((d) => Number.isFinite(d[s.key]))).attr('fill', 'none').style('stroke', s.color)\n      .attr('stroke-width', s.key === 'hold_qqq' ? 1.5 : 2).attr('d', d3.line().x((d) => x(d.date)).y((d) => y(d[s.key])));\n  }\n  svg.append('rect').attr('x', ml).attr('y', mt).attr('width', Math.max(0, W - mr - ml)).attr('height', H - mb - mt).style('fill', 'none').style('pointer-events', 'all');\n  const rule = svg.append('line').attr('y1', mt).attr('y2', H - mb).style('stroke', 'var(--cds-chart-reference)').attr('visibility', 'hidden');\n  const tip = document.createElement('div');\n  tip.className = 'apx-tip';\n  tip.hidden = true;\n  el.append(tip);\n  const bis = d3.bisector((d) => d.date).center;\n  const move = (event) => {\n    const [px] = d3.pointer(event, svg.node());\n    const scale = W / svg.node().getBoundingClientRect().width;\n    const d = data[bis(data, x.invert(px))];\n    if (!d) return;\n    rule.attr('x1', x(d.date)).attr('x2', x(d.date)).attr('visibility', 'visible');\n    tip.replaceChildren();\n    const head = document.createElement('div');\n    head.textContent = fmtDay(d.date);\n    tip.append(head);\n    for (const s of [...SERIES].reverse()) {\n      if (!Number.isFinite(d[s.key])) continue;\n      const line = document.createElement('div');\n      line.textContent = `${s.label}: ${F.usd(d[s.key])}`;\n      tip.append(line);\n    }\n    tip.hidden = false;\n    const left = x(d.date) / scale, tw = tip.offsetWidth, cw = el.clientWidth;\n    tip.style.left = Math.max(0, Math.min(cw - tw, left + 12 + tw > cw ? left - tw - 12 : left + 12)) + 'px';\n    tip.style.top = '8px';\n  };\n  svg.on('pointermove', move).on('pointerdown', move).on('pointerleave', () => { tip.hidden = true; rule.attr('visibility', 'hidden'); });\n});\n</script>\n", "edit": {"via": "claude", "at": "2026-11-10T12:55:00Z"}}